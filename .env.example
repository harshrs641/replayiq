# ═══════════════════════════════════════════
#  ReplayIQ — Environment Configuration
#  Copy to .env and fill in your values
# ═══════════════════════════════════════════

# ── Database ────────────────────────────────
POSTGRES_PASSWORD=your_secure_password_here
# Host port Postgres is published on. Default 5433 (not 5432) avoids
# clashing with a native Postgres install some machines already have
# listening on 127.0.0.1:5432. Used by both docker-compose.yml and dev.sh.
POSTGRES_HOST_PORT=5433
# Optional read replica DSN for the query service. Leave unset to use the
# primary for both reads and writes (fine for dev and small-scale prod).
# DATABASE_READ_URL=postgres://replayiq:password@replica:5432/replayiq?sslmode=disable

# ── Object Storage ──────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_secret_here
# Bucket session events are stored in. Defaults to "sessions" if unset.
# MINIO_BUCKET=sessions
# Bucket the redacted (masked) copy of every session's events is stored in -
# this is what the replay viewer reads by default. Defaults to
# "<MINIO_BUCKET>-masked" if unset.
# MINIO_MASKED_BUCKET=sessions-masked

# ── Data Masking ─────────────────────────────
# Comma-separated extra CSS class names (beyond the built-in "riq-mask")
# that mark an element - and everything inside it - as sensitive in the
# masked replay copy. Elements tagged data-riq-mask, or whose name/id/
# autocomplete attribute looks like card/cvv/ssn/password/phone/email, are
# always redacted; email/credit-card/SSN/phone-shaped text is also redacted
# anywhere it appears as a defense-in-depth net. See backend/internal/masking.
# MASK_CLASSES=sensitive-field,internal-note

# ── Local LLM ───────────────────────────────
OLLAMA_MODEL=llama3.1:8b
# For larger reasoning tasks, use: llama3.1:70b

# ── Jira Integration ────────────────────────
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=ENG

# ── Kafka / Redpanda ────────────────────────
# Comma-separated list of Kafka broker addresses.
# dev.sh starts a single-node Redpanda automatically (no extra config needed).
# For docker-compose the broker is 'redpanda:9092' internally.
# KAFKA_BROKERS=localhost:9092

# ── Service ports (decoupled mode) ──────────
# INGEST_PORT=8081     # SDK-facing ingest API (behind gateway)
# QUERY_PORT=8082      # Dashboard-facing read API (behind gateway)
# GATEWAY_PORT=8080    # Public-facing reverse proxy (matches old monolith port)

# ── AI model tiering ────────────────────────
# OLLAMA_SMALL_MODEL=llama3.2:3b   # used for short/simple sessions
# OLLAMA_LARGE_MODEL=llama3.1:70b  # used for sessions with rage-clicks/errors

# ── Analysis concurrency ────────────────────
# ANALYSIS_CONCURRENCY=4   # max simultaneous Ollama calls

# ── Session retention ───────────────────────
# SESSION_RETENTION_DAYS=90  # auto-purge sessions older than N days on startup

# ── Dashboard ───────────────────────────────
VITE_API_URL=http://localhost:8080
