{
  "manifest_version": 3,
  "name": "ReplayIQ Dev",
  "version": "0.1",
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["rrweb.min.js", "init.js"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
